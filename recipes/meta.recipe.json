{
  "version": "1.1.1",
  "id": "meta",
  "modeSchemaVersion": 2,
  "title": "Meta AI",
  "domainMatch": "meta.ai",
  "url": "https://www.meta.ai/",
  "newChatUrl": "https://www.meta.ai/",
  "partition": "persist:transgentic_meta",
  "authStrategy": "cookie_sync",
  "auth": {
    "requireLoggedInSelector": true,
    "cookieDomains": [
      "meta.ai"
    ],
    "loggedInSelector": "[data-testid=\"user-menu-button\"]",
    "loggedOutSelector": "a[href*=\"/login\"], button[data-testid=\"login-button\"]",
    "loginUrls": [
      "/login",
      "/auth/"
    ]
  },
  "temporaryChat": {
    "enabled": false
  },
  "createdAt": "2026-11-04T00:00:00.000Z",
  "selectors": {
    "inputPrompt": "[data-testid=\"composer-input\"][contenteditable=\"true\"]",
    "submitButton": "button[data-testid=\"composer-send-button\"]",
    "stopButton": "button[data-testid=\"composer-stop-button\"], button[aria-label=\"Stop response\"]",
    "modelDropdownTrigger": "button[data-testid=\"composer-mode-dropdown-button\"]"
  },
  "response": {
    "container": "[data-testid=\"assistant-message\"]",
    "textSelector": ".prose.ur-markdown",
    "actionButtons": "button[aria-label=\"Copy response\"]",
    "generatingIndicator": "button[data-testid=\"composer-stop-button\"]",
    "excludeSelectors": [
      "[data-testid=\"thinking-status\"]",
      "[data-testid=\"subagent-cot-list\"]"
    ],
    "modes": {
      "text": {
        "enabled": true,
        "mediaKind": "text",
        "contentSelector": "img[data-testid=\"ur-image-tile\"], [role=\"slider\"][aria-label=\"Before and after image comparison\"] > img",
        "inputAttachments": {
          "fileInput": "input[type=\"file\"]",
          "trigger": "button[data-testid=\"composer-add-attachment-button\"]",
          "ready": "[data-testid=\"composer-input\"][contenteditable=\"true\"] [data-inline-image-drag-handle=\"true\"][data-inline-image-id]:has(img)",
          "cleanup": "[data-testid=\"composer-input\"] [data-inline-image-id] button[aria-label=\"Remove image\"]",
          "preserveInComposer": "[data-inline-image-drag-handle=\"true\"][data-inline-image-id]",
          "acceptedKinds": [
            "image"
          ],
          "acceptedMimeTypes": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "multiple": false,
          "readyStableMs": 8000
        }
      },
      "image": {
        "enabled": true,
        "mediaKind": "image",
        "contentSelector": "img[data-testid=\"ur-image-tile\"], [role=\"slider\"][aria-label=\"Before and after image comparison\"] > img",
        "generation": {
          "strategy": "prompt",
          "activationSteps": [],
          "readyWhen": {
            "selectors": "[data-testid=\"composer-input\"][contenteditable=\"true\"]"
          },
          "promptInstruction": "Generate a new image for the following request. Return the generated image, rather than instructions for making one.",
          "settings": []
        },
        "inputAttachments": {
          "fileInput": "input[type=\"file\"]",
          "trigger": "button[data-testid=\"composer-add-attachment-button\"]",
          "ready": "[data-testid=\"composer-input\"][contenteditable=\"true\"] [data-inline-image-drag-handle=\"true\"][data-inline-image-id]:has(img)",
          "cleanup": "[data-testid=\"composer-input\"] [data-inline-image-id] button[aria-label=\"Remove image\"]",
          "preserveInComposer": "[data-inline-image-drag-handle=\"true\"][data-inline-image-id]",
          "acceptedKinds": [
            "image"
          ],
          "acceptedMimeTypes": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "multiple": false,
          "readyStableMs": 8000
        }
      },
      "video": {
        "enabled": true,
        "mediaKind": "video",
        "contentSelector": "video",
        "generation": {
          "strategy": "prompt",
          "activationSteps": [],
          "readyWhen": {
            "selectors": "[data-testid=\"composer-input\"][contenteditable=\"true\"]"
          },
          "promptInstruction": "Generate a new video for the following request. Return the generated video, rather than instructions for making one.",
          "settings": []
        },
        "inputAttachments": {
          "fileInput": "input[type=\"file\"]",
          "trigger": "button[data-testid=\"composer-add-attachment-button\"]",
          "ready": "[data-testid=\"composer-input\"][contenteditable=\"true\"] [data-inline-image-drag-handle=\"true\"][data-inline-image-id]:has(img)",
          "cleanup": "[data-testid=\"composer-input\"] [data-inline-image-id] button[aria-label=\"Remove image\"]",
          "preserveInComposer": "[data-inline-image-drag-handle=\"true\"][data-inline-image-id]",
          "acceptedKinds": [
            "image"
          ],
          "acceptedMimeTypes": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "multiple": false,
          "readyStableMs": 8000
        }
      }
    }
  },
  "models": [
    {
      "id": "default",
      "displayName": "Current provider selection",
      "modes": [
        "general",
        "coding",
        "image",
        "video"
      ]
    },
    {
      "id": "instant",
      "displayName": "Instant",
      "modes": [
        "general",
        "coding"
      ]
    },
    {
      "id": "thinking",
      "displayName": "Thinking",
      "modes": [
        "general",
        "coding"
      ]
    }
  ]
}
